	\u{2602}
	\u{2603}
	\u{26A0}
	\u{2B50}
	\u{1FA79}
	\u{1FAE0}
	\u{1FAE8}

emoji_skin_tone :=
	\u{1F3FB}
	\u{1F3FC}
	\u{1F3FD}
	\u{1F3FE}
	\u{1F3FF}
	\u{1F44B}\u{1F3FB}
	\u{1F44B}\u{1F3FF}
	\u{1F469}\u{1F3FD}

emoji_zwj :=
	\u{1F468}\u200D\u{1F469}\u200D\u{1F467}\u200D\u{1F466}
	\u{1F469}\u200D\u{1F4BB}
	\u{1F468}\u200D\u{1F3A8}
	\u{1F469}\u200D\u{2695}\uFE0F
	\u{1F468}\u200D\u{1F468}\u200D\u{1F466}
	\u{1F3F3}\uFE0F\u200D\u{1F308}
	\u{1F3F4}\u200D\u2620\uFE0F
	\u{1F9D1}\u200D\u{1F9D1}\u200D\u{1F9D2}\u200D\u{1F9D2}
	\u{1F468}\u{1F3FB}\u200D\u{2764}\uFE0F\u200D\u{1F468}\u{1F3FF}
	\u{1F935}\u200D\u{2640}\uFE0F

emoji_flag :=
	\u{1F1FA}\u{1F1F8}
	\u{1F1EC}\u{1F1E7}
	\u{1F1E9}\u{1F1EA}
	\u{1F1EF}\u{1F1F5}
