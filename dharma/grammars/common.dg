%%% Common Things - Modern Fuzzing Standard Library

%section% := value

%%% === Boolean Values ===

bool :=
	true
	false
	0
	1
	"true"
	"false"
	""
	null
	undefined

%%% === Digit and Hex ===

digit :=
	%range%(0-9)

hex :=
	%range%(0-9)
	%range%(a-f)
	%range%(A-F)

%%% === Integer Types with Boundary Values ===

byte_int :=
	%range%(0-255)

uint8_boundary :=
	0
	1
	127
	128
	255
	256

int8_boundary :=
	-129
	-128
	-127
	-1
	0
	1
	126
	127
	128

short_int :=
	%range%(0-65535)

uint16_boundary :=
	0
	1
	255
	256
	32767
	32768
	65534
	65535
	65536

int16_boundary :=
	-32769
	-32768
	-32767
	-1
	0
	1
	32766
	32767
	32768

int :=
	%range%(0-4294967295)

uint32_boundary :=
	0
	1
	65535
	65536
	2147483647
	2147483648
	4294967294
	4294967295
	4294967296

int32_boundary :=
	-2147483649
	-2147483648
	-2147483647
	-1
	0
	1
	2147483646
	2147483647
	2147483648

int64_boundary :=
	-9223372036854775809
	-9223372036854775808
	-9223372036854775807
	-1
	0
	1
	9223372036854775806
	9223372036854775807
	9223372036854775808

uint64_boundary :=
	0
	1
	9223372036854775807
	9223372036854775808
	18446744073709551614
	18446744073709551615
	18446744073709551616

sign :=
	+
	-

range_number :=
	%range%(0-9)
	1%range%(0-9)
	12%range%(0-9)
	25%range%(0-9)
	204%range%(0-9)
	3276%range%(0-9)
	6553%range%(0-9)
	214748364%range%(0-9)
	429496729%range%(0-9)

bad_number :=
	+number+
	+range_number+

positive_integer :=
	+digit+
	+byte_int+
	+short_int+
	+int+

integer :=
	+positive_integer+
	+sign++positive_integer+

digits :=
	%repeat%(+digit+)
	+digit+

%%% === IEEE 754 Special Values ===

ieee754_special :=
	NaN
	Infinity
	-Infinity
	-0
	0
	Number.MAX_SAFE_INTEGER
	Number.MIN_SAFE_INTEGER
	Number.EPSILON
	Number.MAX_VALUE
	Number.MIN_VALUE
	Number.POSITIVE_INFINITY
	Number.NEGATIVE_INFINITY
	5e-324
	1.7976931348623157e+308
	2.2250738585072014e-308
	2.2250738585072009e-308
	1e308
	1e-308
	1e309
	0.1 + 0.2
	9007199254740991
	-9007199254740991
	9007199254740992
	9007199254740993
	2147483647
	-2147483648
	4294967295
	4294967296
	1.0000000000000002
	0.9999999999999999

subnormal_float :=
	5e-324
	1e-323
	1.5e-323
	2e-323
	2.2250738585072009e-308
	2.2250738585072014e-308
	1.1125369292536007e-308
	4.9406564584124654e-324

typed_array_boundary :=
	127
	128
	-128
	-129
	255
	256
	32767
	32768
	-32768
	-32769
	65535
	65536
	2147483647
	2147483648
	-2147483648
	-2147483649
	4294967295
	4294967296
	3.4028234663852886e+38
	-3.4028234663852886e+38
	1.1754943508222875e-38
	1.401298464324817e-45

%%% === Decimal and Scientific Numbers ===

decimal_number :=
	+integer+.+digits+
	0.0
	0.5
	1.0
	-0.0
	-1.0
	3.141592653589793
	2.718281828459045
	1.4142135623730951
	0.30000000000000004
	1.7976931348623157e+308

scientific_number :=
	+decimal_number+e+integer+
	+decimal_number+E+integer+
	1e0
	1e-1
	1e+1
	1e10
	1e-10
	1e100
	1e-100
	1e308
	1e-324
	1e309
	5e-324

%%% === Unit and Length ===

unit_identifier :=
	pt
	pc
	cm
	mm
	in
	px
	em
	ex
	rem
	vw
	vh
	vmin
	vmax
	ch
	lh
	rlh
	cap
	ic
	dvw
	dvh
	svw
	svh
	lvw
	lvh
	cqw
	cqh

length :=
	+integer+
	+integer++unit_identifier+
	0
	calc(+integer++unit_identifier+ + +integer++unit_identifier+)
	calc(+integer++unit_identifier+ - +integer++unit_identifier+)
	calc(+integer++unit_identifier+ * +digit+)
	calc(100% - +integer++unit_identifier+)
	min(+integer++unit_identifier+, +integer++unit_identifier+)
	max(+integer++unit_identifier+, +integer++unit_identifier+)
	clamp(+integer++unit_identifier+, +integer++unit_identifier+, +integer++unit_identifier+)

%%% === Number (main rule referenced by other grammars) ===

number :=
	+integer+
	+decimal_number+
	+scientific_number+
	+ieee754_special+
	+subnormal_float+
	+typed_array_boundary+
	0
	1
	-1
	-0
	0.5
	-0.5
	NaN
	Infinity
	-Infinity

%%% === Characters and Text ===

character :=
	%range%(a-z)
	%range%(A-Z)

asciichar :=
	%range%(!-~)

%%% --- Control Characters & Null Bytes ---

unicode_control :=
	\u0000
	\u0001
	\u0002
	\u0003
	\u0004
	\u0005
	\u0006
	\u0007
	\u0008
	\u000B
	\u000C
	\u000E
	\u000F
	\u0010
	\u001B
	\u001F
	\u007F
	\u0080
	\u008D
	\u0090
	\u009D
	\u009F

%%% --- BOM, Noncharacters, Specials ---

unicode_special :=
	\uFEFF
	\uFFFE
	\uFFFF
	\uFFFD
	\uFFFC
	\uFFF9
	\uFFFA
	\uFFFB
	\u{FFFE}
	\u{FFFF}
	\u{1FFFE}
	\u{1FFFF}
	\u{2FFFE}
	\u{10FFFE}
	\u{10FFFF}

%%% --- Surrogates (valid pairs only — lone surrogates break JS string literals) ---

unicode_surrogate :=
	\uD800\uDC00
	\uD800\uDFFF
	\uDB80\uDC00
	\uDBFF\uDC00
	\uDBFF\uDFFF

%%% --- Invisible & Zero-Width Characters ---

unicode_invisible :=
	\u00A0
	\u00AD
	\u034F
	\u061C
	\u115F
	\u1160
	\u17B4
	\u17B5
	\u180E
	\u200B
	\u200C
	\u200D
	\u200E
	\u200F
	\u2028
	\u2029
	\u202F
	\u2060
	\u2061
	\u2062
	\u2063
	\u2064
	\u2066
	\u2067
	\u2068
	\u2069
	\u3164
	\uFFA0

%%% --- Bidi Overrides & Format Characters ---

unicode_bidi :=
	\u0600
	\u0605
	\u06DD
	\u070F
	\u08E2
	\u202A
	\u202B
	\u202C
	\u202D
	\u202E
	\u206A
	\u206B
	\u206C
	\u206D
	\u206E
	\u206F
	\u2066\u2069
	\u202E\u202C
	\u200F\u200E
	\u2067abc\u2069
	\u202Duser\u202C
	\u2066\u2067\u2068\u2069

%%% --- Combining Characters (stack on previous glyph) ---

combining_single :=
	\u0300
	\u0301
	\u0302
	\u0303
	\u0308
	\u030A
	\u0327
	\u0328
	\u0345
	\u035C
	\u0360
	\u0361
	\u0489
	\u20DD
	\u20DE
	\u20DF
	\u20E0
	\u20E3

combining_stack :=
	\u0300\u0301\u0302
	\u0300\u0301\u0302\u0303\u0304\u0305\u0306\u0307\u0308\u0309
	\u0300\u0301\u0302\u0303\u0304\u0305\u0306\u0307\u0308\u0309\u030A\u030B\u030C\u030D\u030E\u030F\u0310\u0311\u0312\u0313
	\u0CC6\u0CC2\u0CD5
	a\u0300\u0301\u0302\u0303\u0304\u0305\u0306\u0307\u0308\u0309\u030A\u030B\u030C\u030D\u030E\u030F
	e\u0300\u0301\u0302\u0303\u0304\u0305\u0306\u0307\u0308\u0309\u030A\u030B\u030C\u030D\u030E\u030F\u0310\u0311\u0312\u0313\u0314\u0315\u0316\u0317\u0318\u0319\u031A\u031B\u031C\u031D\u031E\u031F
	x\u0489\u0489\u0489\u0489\u0489
	o\u20DD\u20DE\u20DF

%%% --- Emoji (single, skin tones, ZWJ sequences, flags) ---

emoji_single :=
	\u{1F600}
	\u{1F601}
	\u{1F602}
	\u{1F60D}
	\u{1F621}
	\u{1F631}
	\u{1F4A9}
