	GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST
	GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.RENDER_ATTACHMENT
	GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.COPY_SRC
	GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST
	GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.COPY_DST
	GPUTextureUsage.COPY_SRC | GPUTextureUsage.COPY_DST | GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.RENDER_ATTACHMENT

