%%% WebGPU API Grammar
%%% W3C Candidate Recommendation Draft, March 2026
%%% https://www.w3.org/TR/webgpu/
%%%
%%% Covers: GPU, GPUAdapter, GPUDevice, GPUBuffer, GPUTexture, GPUSampler,
%%% GPUBindGroupLayout, GPUBindGroup, GPUPipelineLayout, GPUShaderModule,
%%% GPUComputePipeline, GPURenderPipeline, GPUCommandEncoder,
%%% GPURenderPassEncoder, GPUComputePassEncoder, GPUQueue, GPUCanvasContext,
%%% GPUQuerySet, error handling, WGSL shader snippets

%const% OUTPUT_MIN := 5
%const% OUTPUT_MAX := 20
%const% OUTPUT_TEMPLATE := "try { %s } catch(e) {}"
%const% MAX_REPEAT_POWER := 3

%%% =========================================================================
%%% Value Section
%%% =========================================================================

%section% := value

%%% --- Basic numeric helpers ---

smallUint :=
	0
	1
	2
	3
	4
	8
	16
	32
	64
	128
	256

bufferSize :=
	4
	8
	12
	16
	32
	64
	128
	256
	512
	1024
	4096
	65536
	0
	3
	7
	%range%(4-2048)

textureSize :=
	1
	2
	4
	8
	16
	32
	64
	128
	256
	512
	1024

mipLevelCount :=
	1
	2
	3
	4
	5
	%range%(1-10)

sampleCount :=
	1
	4

arrayLayerCount :=
	1
	2
	4
	6
	%range%(1-16)

offset :=
	0
	4
	8
	16
	32
	64
	128
	256
	%range%(0-512)

dynamicOffset :=
	0
	256
	512

float01 :=
	0.0
	0.25
	0.5
	0.75
	1.0

colorValue :=
	0.0
	0.5
	1.0
	%range%(0-9).%range%(0-9)

clearColor :=
	{r: +colorValue+, g: +colorValue+, b: +colorValue+, a: +colorValue+}

workgroupCount :=
	1
	2
	4
	8
	16
	%range%(1-65535)

bindingIndex :=
	0
	1
	2
	3
	%range%(0-7)

groupIndex :=
	0
	1
	2
	3

bytesPerRow :=
	256
	512
	1024
	2048
	%range%(1-4096)
	128
	64

%%% --- Texture formats ---

colorTextureFormat :=
	"r8unorm"
	"r8snorm"
	"r8uint"
	"r8sint"
	"r16uint"
	"r16sint"
	"r16float"
	"rg8unorm"
	"rg8snorm"
